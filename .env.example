TF_VAR_aws_region=us-east-2
TF_VAR_domain=example.com
TF_VAR_project_name=hello-world
# JSON list of {name, subdomain, port} - one entry per service to reverse-proxy.
# Add an entry here to expose another service, no new variable needed.
TF_VAR_proxied_services='[{"name":"hello-world","subdomain":"hello-world","port":8096}]'
TF_VAR_ubuntu_ami_id=ami-0cfde0ea8edd312d4
TF_VAR_wg_ec2_ip=10.10.0.1
# Real EC2-side WireGuard private key, pulled from the running instance's
# /etc/wireguard/wg0.conf. Leave unset to let Tofu generate a fresh one instead.
TF_VAR_wg_ec2_private_key=
TF_VAR_wg_media_sever_ip=10.10.0.2
TF_VAR_zone_id=example
